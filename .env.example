# Copy this file to .env and fill these values locally. Never commit .env.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_auth_token
TWILIO_SMS_FROM=replace_with_your_twilio_sms_sender
TWILIO_WHATSAPP_FROM=replace_with_your_twilio_whatsapp_sender
# Approved WhatsApp flood-alert template Content SID (HX...).
TWILIO_WHATSAPP_CONTENT_SID=replace_with_approved_HX_content_sid
# Approved Twilio WhatsApp template for live heavy-rain detections; never reuse the DEMO DATA template.
TWILIO_WHATSAPP_LIVE_CONTENT_SID=replace_with_approved_live_alert_HX_content_sid
# Optional separate approved template SID for the legacy current-weather endpoint.
TWILIO_WHATSAPP_WEATHER_CONTENT_SID=

# Gmail SMTP alert delivery. Use a Google App Password, not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=replace_with_google_app_password
# Optional; defaults to SMTP_USERNAME.
SMTP_FROM=
